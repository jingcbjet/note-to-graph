# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略）
# 也可用 config.yaml 的 api_key_env 指向别的环境变量名

# 必填：LLM API Key（OpenAI 兼容接口）
NTG_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 选填：覆盖 config.yaml 里的配置
# NTG_LLM_BASE_URL=https://api.siliconflow.cn/v1
# NTG_LLM_MODEL=deepseek-ai/DeepSeek-V3.2
# NTG_EMBED_MODEL=BAAI/bge-large-zh-v1.5
# NTG_DEVICE=cuda

# 选填：HuggingFace 镜像（国内下载 embedding 模型用）
# HF_ENDPOINT=https://hf-mirror.com
